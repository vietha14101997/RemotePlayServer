<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
  <!-- BẮT BUỘC có đuôi -windows10.0.19041.0 để bật WinRT APIs như Windows.Graphics.Capture -->
  <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>

  <!-- Build x64 -->
  <PlatformTarget>x64</PlatformTarget>

  <!-- Cho phép 'unsafe' (dùng trong copy BGRA, Map/Unmap) -->
  <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  <OutputType>Exe</OutputType>

  <!-- Tùy chọn: publish single-file -->
  <!-- <PublishSingleFile>true</PublishSingleFile> -->
</PropertyGroup>

<ItemGroup>
  <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.0.9" />
  <PackageReference Include="SIPSorcery" Version="7.3.1" />
  <PackageReference Include="SIPSorceryMedia.Abstractions" Version="7.3.1" />
  <PackageReference Include="SIPSorceryMedia.Encoders" Version="7.3.1" />
  <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
  <PackageReference Include="Vortice.DXGI" Version="3.6.2" />
</ItemGroup>
</Project>
