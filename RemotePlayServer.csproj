<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  
  <!-- Exclude test project from main compilation -->
  <ItemGroup>
    <Compile Remove="RemotePlayServer.Tests\**" />
    <Content Remove="RemotePlayServer.Tests\**" />
    <EmbeddedResource Remove="RemotePlayServer.Tests\**" />
    <None Remove="RemotePlayServer.Tests\**" />
  </ItemGroup>

  <!-- Let the test project see internal helpers (e.g. IceCandidateInspector) -->
  <ItemGroup>
    <InternalsVisibleTo Include="RemotePlayServer.Tests" />
  </ItemGroup>

  <!-- Copy FFmpeg DLLs from bin folder to output -->
  <ItemGroup>
    <None Include="bin\*.dll" CopyToOutputDirectory="PreserveNewest" LinkBase="bin" />
  </ItemGroup>

  <!-- Copy Configuration files to output -->
  <ItemGroup>
    <None Include="Configuration\*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="Configuration" />
  </ItemGroup>

  <!-- Use Program.cs Main() as entry point instead of WPF auto-generated -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- WebRTC: libdatachannel (replaces SIPSorcery for multi-track support) -->
    <PackageReference Include="DataChannelDotnet" Version="*" />

    <!-- FFmpeg for video encoding -->
    <PackageReference Include="FFmpeg.AutoGen" Version="7.1.1" />
    <PackageReference Include="LibUsbDotNet" Version="3.0.102-alpha" />
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />

    <!-- System utilities -->
    <PackageReference Include="System.Management" Version="9.0.0" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.1.5" />
    <PackageReference Include="QRCoder" Version="1.6.0" />

    <!-- WPF GUI -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
    <PackageReference Include="MahApps.Metro" Version="2.4.10" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.0" />

    <!-- SIPSorcery (kept for backward compatibility, will be removed later) -->
    <PackageReference Include="SIPSorcery" Version="8.0.23" />
    <PackageReference Include="SIPSorceryMedia.Abstractions" Version="8.0.12" />
    <PackageReference Include="SIPSorceryMedia.Encoders" Version="8.0.7" />
    <PackageReference Include="SIPSorceryMedia.FFmpeg" Version="8.0.12" />

    <!-- Audio capture (WASAPI loopback) -->
    <PackageReference Include="NAudio" Version="2.2.1" />

    <!-- DirectX for GPU capture/encoding -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    <PackageReference Include="Vortice.DXGI" Version="3.6.2" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.6.2" />
  </ItemGroup>
</Project>