<UserControl x:Class="RemotePlayServer.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:RemotePlayServer.Converters">
    <UserControl.Resources>
        <converters:BoolToColorConverter x:Key="BoolToColor" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:BoolToLabelConverter x:Key="BoolToAdminLabel" TrueLabel="Administrator" FalseLabel="Limited Mode" />
        <converters:BoolToLabelConverter x:Key="BoolToUsbLabel" TrueLabel="ADB Reverse active" FalseLabel="Not connected" />
        <converters:BoolToLabelConverter x:Key="BoolToNetLabel" TrueLabel="Active" FalseLabel="Idle" />
        <converters:BoolToLabelConverter x:Key="BoolToVirtualLabel" TrueLabel="Virtual" FalseLabel="Physical" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>

            <!-- ═══ KPI TILES ROW ═══ -->
            <UniformGrid Columns="4" Margin="0,0,0,16">
                <!-- Clients -->
                <Border Style="{StaticResource KpiTile}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="⚡" FontSize="18" Foreground="{DynamicResource AppAccentSecondaryBrush}" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding ActiveClientCount}" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextBrush}" />
                        <TextBlock Text="Connected" FontSize="12" Foreground="{DynamicResource AppTextDimBrush}" />
                    </StackPanel>
                </Border>

                <!-- Uptime -->
                <Border Style="{StaticResource KpiTile}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="⏱" FontSize="18" Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding Uptime}" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextBrush}" />
                        <TextBlock Text="Uptime" FontSize="12" Foreground="{DynamicResource AppTextDimBrush}" />
                    </StackPanel>
                </Border>

                <!-- Encoder -->
                <Border Style="{StaticResource KpiTile}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="⚙" FontSize="18" Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding State.Encoder}" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Encoder" FontSize="12" Foreground="{DynamicResource AppTextDimBrush}" />
                    </StackPanel>
                </Border>

                <!-- Network -->
                <Border Style="{StaticResource KpiTile}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="🌐" FontSize="18" Foreground="{DynamicResource AppAccentSecondaryBrush}" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding State.IsRunning, Converter={StaticResource BoolToNetLabel}}"
                                   FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}" />
                        <TextBlock Text="Network" FontSize="12" Foreground="{DynamicResource AppTextDimBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ═══ STATUS + QR ROW ═══ -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Server Status Card -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Server Status" Style="{StaticResource SectionHeader}" />

                        <!-- Running indicator with pulse -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                            <Ellipse x:Name="RunDot" Width="12" Height="12" Margin="0,0,10,0"
                                     Fill="{Binding State.IsRunning, Converter={StaticResource BoolToColor}}" />
                            <TextBlock Text="{Binding State.StatusMessage}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextBrush}" />
                        </StackPanel>

                        <!-- Info Grid -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="IP Address" Style="{StaticResource InfoLabel}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding State.LocalIp}" Style="{StaticResource InfoValue}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Port" Style="{StaticResource InfoLabel}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding State.Port}" Style="{StaticResource InfoValue}" Margin="0,6,0,0" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Codec" Style="{StaticResource InfoLabel}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding State.PreferredCodec}" Style="{StaticResource InfoValue}" Margin="0,6,0,0" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Admin" Style="{StaticResource InfoLabel}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource InfoValue}">
                                        <Setter Property="Text" Value="{Binding State.IsAdmin, Converter={StaticResource BoolToAdminLabel}}" />
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- QR Code Card -->
                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Width="220" VerticalAlignment="Top">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Scan to Connect" Style="{StaticResource SectionHeader}" HorizontalAlignment="Center" />
                        <Border Background="White" CornerRadius="4" Padding="8" Margin="0,4,0,0" HorizontalAlignment="Center">
                            <Image Source="{Binding QrImage}" Width="150" Height="150"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </Border>
                        <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center"
                                Margin="0,10,0,0" Command="{Binding CopyQrDataCommand}" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="Copy Data" FontSize="11" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══ CONNECTION OPTIONS + MONITORS ROW ═══ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Connection Options as Status Pills -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Connection Options" Style="{StaticResource SectionHeader}" />
                        <WrapPanel Margin="0,4,0,0">
                            <!-- USB -->
                            <Border Style="{StaticResource StatusBadge}" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Margin="0,0,6,0"
                                             Fill="{Binding State.AdbReverseActive, Converter={StaticResource BoolToColor}}" />
                                    <TextBlock FontSize="11" Foreground="{DynamicResource AppTextBrush}">
                                        <Run Text="USB " /><Run Text="{Binding State.AdbReverseActive, Converter={StaticResource BoolToUsbLabel}, Mode=OneWay}"
                                             FontSize="10" Foreground="{DynamicResource AppTextDimBrush}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- LAN -->
                            <Border Style="{StaticResource StatusBadge}" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource AppSuccessBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="LAN" FontSize="11" Foreground="{DynamicResource AppTextBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- WiFi -->
                            <Border Style="{StaticResource StatusBadge}" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Margin="0,0,6,0"
                                             Fill="{Binding State.IsRunning, Converter={StaticResource BoolToColor}}" />
                                    <TextBlock FontSize="11" Foreground="{DynamicResource AppTextBrush}">
                                        <Run Text="WiFi " /><Run Text="{Binding State.LocalIp, Mode=OneWay}" FontSize="10"
                                             Foreground="{DynamicResource AppTextDimBrush}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Internet (conditional) -->
                            <Border Style="{StaticResource StatusBadge}" Margin="0,0,8,8"
                                    Visibility="{Binding State.TunnelUrl, Converter={StaticResource NullToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource AppAccentLightBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="Internet" FontSize="11" Foreground="{DynamicResource AppTextBrush}" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <!-- Auth Token -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                    Visibility="{Binding State.AuthToken, Converter={StaticResource NullToVis}}">
                            <TextBlock Foreground="{DynamicResource AppWarningBrush}" FontSize="11">
                                <Run Text="Token: " /><Run Text="{Binding State.AuthToken, Mode=OneWay}" FontWeight="Bold" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Monitors -->
                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}">
                            <Run Text="Monitors (" /><Run Text="{Binding State.Monitors.Count, Mode=OneWay}" /><Run Text=")" />
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding State.Monitors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource AppSurfaceHoverBrush}" CornerRadius="6"
                                            Padding="12,8" Margin="0,0,8,8" MinWidth="140">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppTextBrush}" />
                                            <TextBlock FontSize="12" Foreground="{DynamicResource AppTextDimBrush}" Margin="0,2,0,0">
                                                <Run Text="{Binding Width, Mode=OneTime}" /><Run Text=" x " /><Run Text="{Binding Height, Mode=OneTime}" />
                                            </TextBlock>
                                            <Border CornerRadius="3" Padding="4,1" Margin="0,4,0,0"
                                                    Background="{DynamicResource AppSurfaceBrush}" HorizontalAlignment="Left">
                                                <TextBlock FontSize="10" Foreground="{DynamicResource AppTextDimBrush}"
                                                           Text="{Binding IsVirtual, Converter={StaticResource BoolToVirtualLabel}}" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
