<UserControl x:Class="RemotePlayServer.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:RemotePlayServer.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />

        <!-- TextBox Style -->
        <Style x:Key="LoginTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PasswordBox Style -->
        <Style x:Key="LoginPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Top">

            <!-- ═══ LOGGED IN STATE ═══ -->
            <Border Style="{StaticResource CardBorder}"
                    Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Account" Style="{StaticResource SectionHeader}" />

                    <!-- Account info -->
                    <Border Background="{DynamicResource AppSurfaceHoverBrush}" CornerRadius="8"
                            Padding="16,14" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Ellipse Width="36" Height="36" Fill="{DynamicResource AppAccentBrush}" Margin="0,0,12,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LoggedInEmail}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextBrush}" />
                                    <TextBlock Text="Connected to relay" FontSize="11"
                                               Foreground="{DynamicResource AppSuccessBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Column="0" Text="Server" Style="{StaticResource InfoLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding RelayUrl}" Style="{StaticResource InfoValue}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Logout button -->
                    <Button Style="{StaticResource DangerButton}" Command="{Binding LogoutCommand}"
                            HorizontalAlignment="Left" Padding="16,8">
                        <TextBlock Text="Sign Out" FontSize="12" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- ═══ LOGIN FORM ═══ -->
            <Border Style="{StaticResource CardBorder}"
                    Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel>
                    <!-- Header -->
                    <TextBlock FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource AppAccentLightBrush}" Margin="0,0,0,4">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Sign In" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRegistering}" Value="True">
                                        <Setter Property="Text" Value="Create Account" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock FontSize="11" Foreground="{DynamicResource AppTextDimBrush}" Margin="0,0,0,20">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Connect to relay server for remote access" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRegistering}" Value="True">
                                        <Setter Property="Text" Value="Create a new account on the relay server" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Relay URL -->
                    <TextBlock Text="Relay Server" FontSize="11" Foreground="{DynamicResource AppTextDimBrush}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource LoginTextBox}" Text="{Binding RelayUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                    <!-- Email -->
                    <TextBlock Text="Email" FontSize="11" Foreground="{DynamicResource AppTextDimBrush}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource LoginTextBox}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                    <!-- Username (register only) -->
                    <StackPanel Visibility="{Binding IsRegistering, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                        <TextBlock Text="Username" FontSize="11" Foreground="{DynamicResource AppTextDimBrush}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource LoginTextBox}" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <!-- Password -->
                    <TextBlock Text="Password" FontSize="11" Foreground="{DynamicResource AppTextDimBrush}" Margin="0,0,0,4" />
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource LoginPasswordBox}" Margin="0,0,0,16"
                                 PasswordChanged="PasswordBox_PasswordChanged" />

                    <!-- Remember Me -->
                    <CheckBox Content="Remember me" FontSize="12" Cursor="Hand"
                              Foreground="{DynamicResource AppTextDimBrush}"
                              IsChecked="{Binding RememberMe}" Margin="0,0,0,16"
                              Visibility="{Binding IsRegistering, Converter={StaticResource InverseBoolToVis}}" />

                    <!-- Error message -->
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="11"
                               Foreground="{DynamicResource AppErrorBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}" />

                    <!-- Status message -->
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                               Foreground="{DynamicResource AppAccentSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,8"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                    <!-- Submit button -->
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding SubmitCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                            Padding="16,12" Margin="0,0,0,12">
                        <TextBlock FontSize="13" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Sign In" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRegistering}" Value="True">
                                            <Setter Property="Text" Value="Create Account" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Text" Value="Connecting..." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                    <!-- Toggle login/register -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock FontSize="12" Foreground="{DynamicResource AppTextDimBrush}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Don't have an account?" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRegistering}" Value="True">
                                            <Setter Property="Text" Value="Already have an account?" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Style="{StaticResource IconButton}" Width="Auto" Height="Auto"
                                Command="{Binding ToggleModeCommand}" Margin="4,0,0,0">
                            <TextBlock FontSize="12" Foreground="{DynamicResource AppAccentLightBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Sign Up" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRegistering}" Value="True">
                                                <Setter Property="Text" Value="Sign In" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
