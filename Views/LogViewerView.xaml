<UserControl x:Class="RemotePlayServer.Views.LogViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:RemotePlayServer.Converters">
    <UserControl.Resources>
        <converters:LogLevelToBrushConverter x:Key="LevelToBrush" />
        <converters:IntEqualsToBoolConverter x:Key="IntEqualsToBool" />

        <!-- Chip-style toggle used for filter selection and auto-scroll -->
        <Style x:Key="FilterChip" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource AppTextDimBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{DynamicResource AppSurfaceHoverBrush}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppSurfaceElevatedBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppAccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Open Folder" Style="{StaticResource SecondaryButton}"
                        Command="{Binding OpenLogsFolderCommand}" Margin="0,0,8,0"
                        ToolTip="Open the logs directory on disk" />
                <Button Content="Clear" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ClearLogsCommand}"
                        ToolTip="Clear the on-screen log history (log files are kept)" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Logs" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextBrush}" />
                <TextBlock Text="Server logs, connection events, and diagnostics"
                           FontSize="12" Foreground="{DynamicResource AppTextDimBrush}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Filter bar -->
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <ToggleButton DockPanel.Dock="Right" Content="Auto-scroll" Style="{StaticResource FilterChip}"
                          IsChecked="{Binding AutoScroll, Mode=TwoWay}" Margin="0" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Filter:" FontSize="11" Foreground="{DynamicResource AppTextDimBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <RadioButton Content="All" GroupName="LogFilter" Style="{StaticResource FilterChip}"
                             IsChecked="{Binding FilterIndex, Mode=TwoWay, Converter={StaticResource IntEqualsToBool}, ConverterParameter=0}" />
                <RadioButton Content="Warning" GroupName="LogFilter" Style="{StaticResource FilterChip}"
                             IsChecked="{Binding FilterIndex, Mode=TwoWay, Converter={StaticResource IntEqualsToBool}, ConverterParameter=1}" />
                <RadioButton Content="Error" GroupName="LogFilter" Style="{StaticResource FilterChip}"
                             IsChecked="{Binding FilterIndex, Mode=TwoWay, Converter={StaticResource IntEqualsToBool}, ConverterParameter=2}" />
            </StackPanel>
        </DockPanel>

        <!-- Log list -->
        <Border Grid.Row="2" Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                CornerRadius="{StaticResource CardRadius}" Padding="12">
            <Grid>
                <!-- Empty state -->
                <TextBlock Text="No log entries yet" FontSize="12"
                           Foreground="{DynamicResource AppTextDimBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasEntries}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ListBox x:Name="LogList" ItemsSource="{Binding Entries}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,1" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" Padding="4,1">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap">
                                <Run Text="{Binding Timestamp, Mode=OneWay, StringFormat=HH:mm:ss.fff}"
                                     Foreground="{DynamicResource AppTextDimBrush}" /><Run Text="  " /><Run
                                     Text="{Binding Message, Mode=OneWay}"
                                     Foreground="{Binding Level, Converter={StaticResource LevelToBrush}}" />
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
