<UserControl x:Class="RemotePlayServer.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:converters="clr-namespace:RemotePlayServer.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="640">

            <!-- Save Status Toast -->
            <Border Visibility="{Binding SaveStatus, Converter={StaticResource NullToVis}}"
                    Background="{DynamicResource AppAccentBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,12" Opacity="0.9">
                <TextBlock Text="{Binding SaveStatus}" Foreground="White" FontSize="12" />
            </Border>

            <!-- ═══ CODEC SETTINGS ═══ -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Codec Settings" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="Preferred encoding codec for streaming sessions" Style="{StaticResource InfoLabel}"
                               FontStyle="Italic" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Preferred Codec" Style="{StaticResource InfoLabel}"
                                   VerticalAlignment="Center" Width="140" />
                        <ComboBox ItemsSource="{Binding CodecOptions}" SelectedItem="{Binding PreferredCodec}" Width="160" />
                        <Button Style="{StaticResource PrimaryButton}" Margin="12,0,0,0"
                                Command="{Binding SaveCodecCommand}" Padding="16,6">
                            <Grid>
                                <TextBlock Text="Save">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSavingCodec}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <mah:ProgressRing Width="14" Height="14" IsActive="{Binding IsSavingCodec}"
                                                  Visibility="{Binding IsSavingCodec, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Takes effect on next client connection" Style="{StaticResource InfoLabel}"
                               FontStyle="Italic" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- ═══ VR MODE SETTINGS ═══ -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="VR Game Mode Settings" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="Select running applications or enter process names manually to assign them to VR Mode. When focused, stereoscopic SBS VR Mode will be activated."
                               Style="{StaticResource InfoLabel}" FontStyle="Italic" Margin="0,0,0,12" />

                    <!-- Dual List Container -->
                    <Grid Height="200" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Running Applications -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Applications:" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource AppTextDimBrush}" FontSize="12" />
                            <Border Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}" CornerRadius="4" Background="{DynamicResource AppSurfaceBrush}">
                                <ListBox ItemsSource="{Binding RunningApps}"
                                         SelectedItem="{Binding SelectedRunningApp}"
                                         DisplayMemberPath="DisplayName"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            </Border>
                        </Grid>

                        <!-- Center: Commands -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Button Content="▶" FontSize="16" Width="40" Height="32" Margin="0,4" Padding="0"
                                    ToolTip="Add selected app to VR Favorites"
                                    Command="{Binding AddFavoriteCommand}" Style="{StaticResource PrimaryButton}" />
                            <Button Content="◀" FontSize="16" Width="40" Height="32" Margin="0,4" Padding="0"
                                    ToolTip="Remove selected app from VR Favorites"
                                    Command="{Binding RemoveFavoriteCommand}" Style="{StaticResource PrimaryButton}" />
                            <Button Content="▲" FontSize="12" Width="36" Height="28" Margin="0,12,0,4" Padding="0"
                                    ToolTip="Move up"
                                    Command="{Binding MoveFavoriteUpCommand}" Style="{StaticResource SecondaryButton}" />
                            <Button Content="▼" FontSize="12" Width="36" Height="28" Margin="0,4" Padding="0"
                                    ToolTip="Move down"
                                    Command="{Binding MoveFavoriteDownCommand}" Style="{StaticResource SecondaryButton}" />
                        </StackPanel>

                        <!-- Right: VR Favorites -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Favorites (automatic):" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource AppTextDimBrush}" FontSize="12" />
                            <Border Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}" CornerRadius="4" Background="{DynamicResource AppSurfaceBrush}">
                                <ListBox ItemsSource="{Binding FavoriteVRGames}"
                                         SelectedItem="{Binding SelectedFavoriteVRGame}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Add Custom Game & Refresh Panels -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <!-- Manual Entry -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBox Text="{Binding CustomGameName, UpdateSourceTrigger=PropertyChanged}" 
                                     mah:TextBoxHelper.Watermark="Or enter process name (e.g. Subnautica)"
                                     Width="260" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Content="Add Manual" Command="{Binding AddCustomFavoriteCommand}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Padding="12,6" />
                        </StackPanel>

                        <!-- Refresh Running Apps -->
                        <Button Grid.Column="1" Content="🔄 Refresh Apps" Command="{Binding RefreshRunningAppsCommand}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Padding="12,6" />
                    </Grid>

                    <!-- Actions -->
                    <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="16,8"
                            Command="{Binding SaveVRGamesListCommand}">
                        <Grid>
                            <TextBlock Text="Save VR Games Settings">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSavingVRGames}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <mah:ProgressRing Width="14" Height="14" IsActive="{Binding IsSavingVRGames}"
                                              Visibility="{Binding IsSavingVRGames, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ═══ INTERNET MODE ═══ -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Internet Mode" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="Enable Cloudflare tunnel for internet-based connections" Style="{StaticResource InfoLabel}"
                               FontStyle="Italic" Margin="0,0,0,8" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Enable" Style="{StaticResource InfoLabel}" VerticalAlignment="Center" Width="140" />
                        <mah:ToggleSwitch IsOn="{Binding InternetEnabled}" OnContent="On" OffContent="Off" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding InternetEnabled, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="TURN Server" Style="{StaticResource InfoLabel}" VerticalAlignment="Center" Width="140" />
                            <TextBox Text="{Binding TurnServerUrl, UpdateSourceTrigger=PropertyChanged}" Width="320" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Username" Style="{StaticResource InfoLabel}" VerticalAlignment="Center" Width="140" />
                            <TextBox Text="{Binding TurnUsername, UpdateSourceTrigger=PropertyChanged}" Width="320" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Password" Style="{StaticResource InfoLabel}" VerticalAlignment="Center" Width="140" />
                            <TextBox Text="{Binding TurnPassword, UpdateSourceTrigger=PropertyChanged}" Width="320"
                                     mah:TextBoxHelper.Watermark="Enter password" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                            <TextBlock Text="Require Token" Style="{StaticResource InfoLabel}" VerticalAlignment="Center" Width="140" />
                            <mah:ToggleSwitch IsOn="{Binding RequireToken}" OnContent="Yes" OffContent="No" />
                        </StackPanel>
                    </StackPanel>

                    <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="16,6"
                            Command="{Binding SaveInternetSettingsCommand}">
                        <Grid>
                            <TextBlock Text="Save Internet Settings">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSavingInternet}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <mah:ProgressRing Width="14" Height="14" IsActive="{Binding IsSavingInternet}"
                                              Visibility="{Binding IsSavingInternet, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ═══ SYSTEM ═══ -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="System" Style="{StaticResource SectionHeader}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Start with Windows" Style="{StaticResource InfoLabel}" VerticalAlignment="Center" Width="140" />
                        <mah:ToggleSwitch IsOn="{Binding AutoStartEnabled}" OnContent="On" OffContent="Off"
                                          Toggled="AutoStartToggled" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══ DISPLAY CONFIG ═══ -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Display Configuration" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="Save current monitor arrangement as default for future sessions"
                               Style="{StaticResource InfoLabel}" FontStyle="Italic" Margin="0,0,0,12" />
                    <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="16,8"
                            Command="{Binding SaveDisplayConfigAsDefaultCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Save Config as Default" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ═══ PLACEHOLDER SECTIONS ═══ -->

            <!-- Performance -->
            <Grid Margin="0,0,0,12">
                <Border Style="{StaticResource PlaceholderCard}">
                    <StackPanel>
                        <TextBlock Text="Performance" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="Bitrate limits, FPS caps, resolution scaling" Style="{StaticResource InfoLabel}" FontStyle="Italic" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Max Bitrate" Width="140" Style="{StaticResource InfoLabel}" />
                            <TextBlock Text="10 Mbps" Style="{StaticResource InfoValue}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="FPS Limit" Width="140" Style="{StaticResource InfoLabel}" />
                            <TextBlock Text="60" Style="{StaticResource InfoValue}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource AppComingSoonBrush}" CornerRadius="4" Padding="8,3"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,8,0">
                    <TextBlock Text="COMING SOON" FontSize="9" FontWeight="Bold" Foreground="White" />
                </Border>
            </Grid>

            <!-- Display -->
            <Grid Margin="0,0,0,12">
                <Border Style="{StaticResource PlaceholderCard}">
                    <StackPanel>
                        <TextBlock Text="Display" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="Virtual display management, monitor arrangement" Style="{StaticResource InfoLabel}" FontStyle="Italic" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Virtual Display" Width="140" Style="{StaticResource InfoLabel}" />
                            <TextBlock Text="Off" Style="{StaticResource InfoValue}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Resolution" Width="140" Style="{StaticResource InfoLabel}" />
                            <TextBlock Text="Native" Style="{StaticResource InfoValue}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource AppComingSoonBrush}" CornerRadius="4" Padding="8,3"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,8,0">
                    <TextBlock Text="COMING SOON" FontSize="9" FontWeight="Bold" Foreground="White" />
                </Border>
            </Grid>

            <!-- Audio -->
            <Grid Margin="0,0,0,12">
                <Border Style="{StaticResource PlaceholderCard}">
                    <StackPanel>
                        <TextBlock Text="Audio" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="Audio routing, volume, device selection" Style="{StaticResource InfoLabel}" FontStyle="Italic" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Device" Width="140" Style="{StaticResource InfoLabel}" />
                            <TextBlock Text="Default" Style="{StaticResource InfoValue}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Volume" Width="140" Style="{StaticResource InfoLabel}" />
                            <TextBlock Text="100%" Style="{StaticResource InfoValue}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource AppComingSoonBrush}" CornerRadius="4" Padding="8,3"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,8,0">
                    <TextBlock Text="COMING SOON" FontSize="9" FontWeight="Bold" Foreground="White" />
                </Border>
            </Grid>

            <!-- Security -->
            <Grid Margin="0,0,0,12">
                <Border Style="{StaticResource PlaceholderCard}">
                    <StackPanel>
                        <TextBlock Text="Security" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="IP whitelist, session timeout, encryption" Style="{StaticResource InfoLabel}" FontStyle="Italic" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Session Timeout" Width="140" Style="{StaticResource InfoLabel}" />
                            <TextBlock Text="30 min" Style="{StaticResource InfoValue}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Encryption" Width="140" Style="{StaticResource InfoLabel}" />
                            <TextBlock Text="AES-256" Style="{StaticResource InfoValue}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource AppComingSoonBrush}" CornerRadius="4" Padding="8,3"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,8,0">
                    <TextBlock Text="COMING SOON" FontSize="9" FontWeight="Bold" Foreground="White" />
                </Border>
            </Grid>

            <!-- Advanced -->
            <Grid Margin="0,0,0,12">
                <Border Style="{StaticResource PlaceholderCard}">
                    <StackPanel>
                        <TextBlock Text="Advanced" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="Log level, debug mode, experimental features" Style="{StaticResource InfoLabel}" FontStyle="Italic" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Log Level" Width="140" Style="{StaticResource InfoLabel}" />
                            <TextBlock Text="Info" Style="{StaticResource InfoValue}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Debug Mode" Width="140" Style="{StaticResource InfoLabel}" />
                            <TextBlock Text="Off" Style="{StaticResource InfoValue}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource AppComingSoonBrush}" CornerRadius="4" Padding="8,3"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,8,0">
                    <TextBlock Text="COMING SOON" FontSize="9" FontWeight="Bold" Foreground="White" />
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
